diff --git a/main.c b/main.c
--- a/main.c
+++ b/main.c
@@ -1169,6 +1169,32 @@ int acx_op_hw_scan(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 	return ret;
 }
 
+void acx_op_cancel_hw_scan(struct ieee80211_hw *hw, struct ieee80211_vif *vif)
+{
+	acx_device_t *adev = hw2adev(hw);
+#if CONFIG_ACX_MAC80211_VERSION >= KERNEL_VERSION(4, 8, 0)
+	struct cfg80211_scan_info info = {
+		.aborted = true,
+	};
+#endif
+
+	acx_sem_lock(adev);
+	if (!test_and_clear_bit(ACX_FLAG_SCANNING, &adev->flags)) {
+		acx_sem_unlock(adev);
+		return;
+	}
+
+	/* Stop firmware activity before releasing mac80211's scan request. */
+	acx_issue_cmd(adev, ACX1xx_CMD_STOP_SCAN, NULL, 0);
+	acx_sem_unlock(adev);
+
+#if CONFIG_ACX_MAC80211_VERSION >= KERNEL_VERSION(4, 8, 0)
+	ieee80211_scan_completed(adev->hw, &info);
+#else
+	ieee80211_scan_completed(adev->hw, true);
+#endif
+}
+
