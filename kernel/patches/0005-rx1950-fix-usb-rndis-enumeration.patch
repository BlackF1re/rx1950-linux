diff --git a/arch/arm/mach-s3c/mach-rx1950.c b/arch/arm/mach-s3c/mach-rx1950.c
--- a/arch/arm/mach-s3c/mach-rx1950.c
+++ b/arch/arm/mach-s3c/mach-rx1950.c
@@ -650,5 +650,5 @@
 static struct gpiod_lookup_table rx1950_udc_gpio_table = {
-	.dev_id = "s3c2410-usbgadget",
+	.dev_id = "s3c2440-usbgadget",
 	.table = {
 		GPIO_LOOKUP("GPIOG", 5, "vbus", GPIO_ACTIVE_LOW),
 		GPIO_LOOKUP("GPIOJ", 5, "pullup", GPIO_ACTIVE_HIGH),
@@ -827,4 +827,15 @@
 						S3C2410_MISCCR_USBSUSPND0 |
 						S3C2410_MISCCR_USBSUSPND1, 0x0);
 
+	/*
+	 * HaRET hands the machine over from Windows Mobile with the sync cable
+	 * potentially already attached.  Force the external D+ pull-up low
+	 * before the Linux UDC is registered so the host never enumerates stale
+	 * Windows state.  The UDC later claims GPJ5 through the descriptor lookup.
+	 */
+	if (!WARN_ON(gpio_request(S3C2410_GPJ(5), "USB pull-up quiesce"))) {
+		WARN_ON(gpio_direction_output(S3C2410_GPJ(5), 0));
+		gpio_free(S3C2410_GPJ(5));
+	}
+
 	/* mmc power is disabled by default */
