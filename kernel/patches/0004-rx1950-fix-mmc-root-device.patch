diff --git a/arch/arm/mach-s3c/mach-rx1950.c b/arch/arm/mach-s3c/mach-rx1950.c
--- a/arch/arm/mach-s3c/mach-rx1950.c
+++ b/arch/arm/mach-s3c/mach-rx1950.c
@@ -547,8 +547,13 @@ static struct s3c24xx_mci_pdata rx1950_mmc_cfg __initdata = {
 	.set_power = rx1950_set_mmc_power,
 	.ocr_avail = MMC_VDD_32_33,
 };
+
 static struct gpiod_lookup_table rx1950_mmc_gpio_table = {
-	.dev_id = "s3c2410-sdi",
+	/*
+	 * s3c244x_map_io() renames the legacy SDI platform device before
+	 * rx1950_init_machine() installs this lookup table.
+	 */
+	.dev_id = "s3c2440-sdi",
 	.table = {
 		/* Card detect S3C2410_GPF(5) */
 		GPIO_LOOKUP("GPIOF", 5, "cd", GPIO_ACTIVE_LOW),
diff --git a/drivers/mmc/host/s3cmci.c b/drivers/mmc/host/s3cmci.c
--- a/drivers/mmc/host/s3cmci.c
+++ b/drivers/mmc/host/s3cmci.c
@@ -1358,13 +1358,19 @@ static int s3cmci_probe_pdata(struct s3cmci_host *host)
 	}
 
+	dev_notice(&pdev->dev,
+		   "RX1950 MMC: platform probe device=%s controller=%s\n",
+		   dev_name(&pdev->dev), host->is2440 ? "s3c2440" : "s3c2410");
+
 	for (i = 0; i < 6; i++) {
 		pdata->bus[i] = devm_gpiod_get_index(&pdev->dev, "bus", i,
 						     GPIOD_OUT_LOW);
 		if (IS_ERR(pdata->bus[i])) {
-			dev_err(&pdev->dev, "failed to get gpio %d\n", i);
+			dev_err(&pdev->dev, "RX1950 MMC: failed to get bus gpio %d: %ld\n",
+				i, PTR_ERR(pdata->bus[i]));
 			return PTR_ERR(pdata->bus[i]);
 		}
 	}
+	dev_notice(&pdev->dev, "RX1950 MMC: all six SD bus GPIOs acquired\n");
 
 	if (pdata->no_wprotect)
 		mmc->caps2 |= MMC_CAP2_NO_WRITE_PROTECT;
@@ -1513,7 +1519,11 @@ static int s3cmci_probe(struct platform_device *pdev)
 	}
 
 	host->clk_rate = clk_get_rate(host->clk);
+	dev_notice(&pdev->dev,
+		   "RX1950 MMC: resources ready irq=%d dma=%s clock=%luHz\n",
+		   host->irq, s3cmci_host_usedma(host) ? "yes" : "no",
+		   host->clk_rate);
 
 	mmc->ops 	= &s3cmci_ops;
 	mmc->ocr_avail	= MMC_VDD_32_33 | MMC_VDD_33_34;
 #ifdef CONFIG_MMC_S3C_HW_SDIO_IRQ
@@ -1540,11 +1550,14 @@ static int s3cmci_probe(struct platform_device *pdev)
 		goto free_dmabuf;
 	}
 
+	dev_notice(&pdev->dev, "RX1950 MMC: registering MMC host\n");
 	ret = mmc_add_host(mmc);
 	if (ret) {
 		dev_err(&pdev->dev, "failed to add mmc host.\n");
 		goto free_cpufreq;
 	}
+	dev_notice(&pdev->dev, "RX1950 MMC: host registered as %s\n",
+		   mmc_hostname(mmc));
 
 	s3cmci_debugfs_attach(host);
 
diff --git a/drivers/base/dd.c b/drivers/base/dd.c
--- a/drivers/base/dd.c
+++ b/drivers/base/dd.c
@@ -730,8 +730,9 @@ int driver_probe_done(void)
 {
 	int local_probe_count = atomic_read(&probe_count);
 
-	pr_debug("%s: probe_count = %d\n", __func__, local_probe_count);
+	pr_debug_ratelimited("%s: probe_count = %d\n", __func__,
+			     local_probe_count);
 	if (local_probe_count)
 		return -EBUSY;
 	return 0;
 }
