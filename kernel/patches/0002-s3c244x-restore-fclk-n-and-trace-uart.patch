+/*
+ * S3C2440/S3C2442 UART source 3 is FCLK divided by a shared divider encoded
+ * in the UART UCON registers.  The legacy S3C24xx clock code exported this as
+ * clk_uart_baud3/fclk_n, but the CCF conversion in v3.16 lost that clock while
+ * legacy boards such as the HP iPAQ rx1950 kept selecting source 3.
+ *
+ * Keep the historical rate calculation verbatim.  The divider fields are
+ * shared in a peculiar way: UART0 supplies divisors 6..21, UART1 21..36,
+ * UART2 36..43, and the all-zero state observed on real hardware is /9.
+ */
+static void __iomem *s3c244x_uart_base;
+
+static unsigned long s3c244x_fclk_n_recalc_rate(struct clk_hw *hw,
+						 unsigned long parent_rate)
+{
+	u32 ucon0, ucon1, ucon2;
+	unsigned int divisor;
+
+	if (WARN_ON_ONCE(!s3c244x_uart_base))
+		return parent_rate / 9;
+
+	ucon0 = readl_relaxed(s3c244x_uart_base + S3C2410_UCON);
+	ucon1 = readl_relaxed(s3c244x_uart_base + S3C244X_UART_STRIDE +
+			      S3C2410_UCON);
+	ucon2 = readl_relaxed(s3c244x_uart_base + 2 * S3C244X_UART_STRIDE +
+			      S3C2410_UCON);
+
+	ucon0 &= S3C2440_UCON0_DIVMASK;
+	ucon1 &= S3C2440_UCON1_DIVMASK;
+	ucon2 &= S3C2440_UCON2_DIVMASK;
+
+	if (ucon0)
+		divisor = (ucon0 >> S3C2440_UCON_DIVSHIFT) + 6;
+	else if (ucon1)
+		divisor = (ucon1 >> S3C2440_UCON_DIVSHIFT) + 21;
+	else if (ucon2)
+		divisor = (ucon2 >> S3C2440_UCON_DIVSHIFT) + 36;
+	else
+		divisor = 9;
+
+	return parent_rate / divisor;
+}
+
+static const struct clk_ops s3c244x_fclk_n_ops = {
+	.recalc_rate = s3c244x_fclk_n_recalc_rate,
+};
