+	.parent_names = s3c244x_fclk_n_parents,
+	.num_parents = ARRAY_SIZE(s3c244x_fclk_n_parents),
+	.flags = CLK_GET_RATE_NOCACHE,
+};
+
+static struct clk_hw s3c244x_fclk_n_hw = {
+	.init = &s3c244x_fclk_n_init,
+};
+
+static int __init s3c244x_register_fclk_n(void)
+{
+	int ret;
+
+	s3c244x_uart_base = ioremap(S3C244X_UART_PHYS, S3C244X_UART_MAP_SIZE);
+	if (!s3c244x_uart_base)
+		return -ENOMEM;
+
+	ret = clk_hw_register(NULL, &s3c244x_fclk_n_hw);
+	if (ret)
+		return ret;
+
+	ret = clk_hw_register_clkdev(&s3c244x_fclk_n_hw, "clk_uart_baud3",
+				     "s3c2440-uart.0");
+	if (ret)
+		return ret;
+	ret = clk_hw_register_clkdev(&s3c244x_fclk_n_hw, "clk_uart_baud3",
+				     "s3c2440-uart.1");
+	if (ret)
+		return ret;
+	return clk_hw_register_clkdev(&s3c244x_fclk_n_hw, "clk_uart_baud3",
+				      "s3c2440-uart.2");
+}
