 	select S3C_DEV_NAND
 	help
 	  Say Y here if you're using HP iPAQ rx1950
diff --git a/arch/arm/mach-s3c/mach-rx1950.c b/arch/arm/mach-s3c/mach-rx1950.c
--- a/arch/arm/mach-s3c/mach-rx1950.c
+++ b/arch/arm/mach-s3c/mach-rx1950.c
@@ -43,5 +43,6 @@
 #include <linux/platform_data/touchscreen-s3c2410.h>
 #include <linux/platform_data/usb-s3c2410_udc.h>
 #include <linux/platform_data/fb-s3c2410.h>
+#include <linux/platform_data/hwmon-s3c.h>
 
 #include <sound/uda1380.h>
@@ -349,5 +350,21 @@
 	.current_mult = 2900,
 	.internal_impedance = 200,
+};
+
+/*
+ * ADC channel 0 is the battery-voltage divider.  The battery driver converts
+ * the same raw sample to microvolts with a factor of 4235; hwmon expects
+ * millivolts for in*_input, hence the corresponding 4235/1000 scale.
+ * All ADC channels are additionally exposed unscaled by SENSORS_S3C_RAW.
+ */
+static struct s3c_hwmon_chcfg rx1950_hwmon_battery_voltage = {
+	.name = "main-battery",
+	.mult = 4235,
+	.div = 1000,
+};
+
+static struct s3c_hwmon_pdata rx1950_hwmon_pdata = {
+	.in[0] = &rx1950_hwmon_battery_voltage,
 };
 
 static struct platform_device rx1950_battery = {
