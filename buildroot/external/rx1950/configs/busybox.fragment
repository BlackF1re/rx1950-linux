CONFIG_NTPD=y
# CONFIG_FEATURE_NTPD_SERVER is not set
CONFIG_TIMEOUT=y
# The RAM-only cable recovery deliberately exposes a one-shot listener on the
# physically point-to-point USB NCM link.  It avoids Dropbear's unreliable
# encrypted transport on the PXA27x while the root filesystem is unavailable.
CONFIG_NC=y
CONFIG_NC_SERVER=y
