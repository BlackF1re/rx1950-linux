config BR2_PACKAGE_GPE_CONF_RX1950
	bool "gpe-conf-rx1950"
	depends on BR2_PACKAGE_XORG7
	depends on BR2_USE_WCHAR
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_MMU
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_SYNC_4
	select BR2_PACKAGE_LIBGTK2
	help
	  Touch-oriented, on-demand control center for the HP iPAQ rx1950.
	  It retains the extensible applet model of GPE Conf while using the
	  board's current sysfs, ALSA and WEXT helpers. It has no resident
	  process and never installs a setuid executable.
