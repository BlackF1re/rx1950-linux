config BR2_PACKAGE_RX1950_SHELL
	bool "rx1950-shell"
	depends on BR2_PACKAGE_XORG7
	depends on BR2_USE_MMU
	select BR2_PACKAGE_XLIB_LIBX11
	help
	  Single-process, Xlib-only home screen, launcher, task strip and
	  status panel for the HP iPAQ rx1950. It deliberately avoids GTK,
	  Xft, icon themes, D-Bus and resident helper processes.
