#!/bin/sh
# Small on-demand Wi-Fi manager for the ACX100 radio.

set -u
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH
DIALOG=dialog
CONF=/etc/wpa_supplicant.conf

message() {
    "$DIALOG" --clear --title "$1" --msgbox "$2" 15 36
}

iface() {
    for path in /sys/class/net/wlan*; do
        [ -e "$path" ] || continue
        basename "$path"
        return 0
    done
    return 1
}

ensure_radio() {
    if dev=$(iface 2>/dev/null); then
        iw reg set RU >/dev/null 2>&1 || true
        ip link set "$dev" up || {
            message Error 'The Wi-Fi interface could not be enabled.'
            return 1
        }
        return 0
    fi
    "$DIALOG" --infobox 'Starting Wi-Fi radio...' 5 32
    output=$(rx1950-wlan start 2>&1) || {
        message Error "$output"
        return 1
    }
}

escape_config() {
    printf '%s' "$1" | sed 's/[\\"]/\\&/g'
}

scan_networks() {
    ensure_radio || return
    dev=$(iface)
    list=/tmp/rx1950-ssid.$$
    raw=/tmp/rx1950-scan.$$
    error=/tmp/rx1950-scan-error.$$
    trap 'rm -f "$list" "$raw" "$error"' EXIT HUP INT TERM
    "$DIALOG" --infobox 'Scanning networks...' 5 30
    if ! iw dev "$dev" scan > "$raw" 2> "$error"; then
        detail=$(cat "$error" 2>/dev/null)
        message Error "Scan failed.\n$detail"
        return
    fi
    sed -n 's/^[[:space:]]*SSID: //p' "$raw" | sed '/^$/d' | sort -u > "$list"
    [ -s "$list" ] || {
        message Wi-Fi 'No networks were found.'
        return
    }

    set --
    number=0
    while IFS= read -r name; do
        number=$((number + 1))
        set -- "$@" "$number" "$name"
    done < "$list"
    selected=$("$DIALOG" --stdout --title 'Wi-Fi networks' \
        --menu 'Select a network' 22 38 14 "$@") || return
    ssid=$(sed -n "${selected}p" "$list")

    security=$("$DIALOG" --stdout --title "$ssid" --menu 'Security' 12 34 3 \
        wpa 'WPA/WPA2 personal' open 'Open network') || return
    escaped_ssid=$(escape_config "$ssid")
    case "$security" in
        open)
            psk_lines='    key_mgmt=NONE'
            ;;
        wpa)
            password=$("$DIALOG" --stdout --insecure --title "$ssid" \
                --passwordbox 'Passphrase (8-63 characters)' 10 36) || return
            case ${#password} in
                [0-7]|6[4-9]|[7-9][0-9]*)
                    message Error 'A WPA passphrase must contain 8 to 63 characters.'
                    return
                    ;;
            esac
            escaped_password=$(escape_config "$password")
            psk_lines="    key_mgmt=WPA-PSK
    psk=\"$escaped_password\""
            unset password escaped_password
            ;;
    esac

    umask 077
    {
        printf 'ctrl_interface=/var/run/wpa_supplicant\n'
        printf 'update_config=1\ncountry=RU\nap_scan=1\n\n'
        printf 'network={\n    ssid="%s"\n    scan_ssid=1\n%s\n}\n' \
            "$escaped_ssid" "$psk_lines"
    } > "$CONF"

    "$DIALOG" --infobox "Connecting to $ssid..." 5 36
    if output=$(rx1950-wlan connect 2>&1); then
        dev=$(iface)
        address=$(ip -4 -o addr show dev "$dev" 2>/dev/null | awk '{print $4}' | head -1)
        message Connected "$ssid\n${address:-No IPv4 address}"
    else
        message Error "Connection failed.\n$output"
    fi
}

show_status() {
    ensure_radio || return
    dev=$(iface)
    report=/tmp/rx1950-wifi-status.$$
    {
        iw dev "$dev" link 2>&1
        printf '\n'
        ip -4 addr show dev "$dev" 2>&1
        printf '\nRoutes:\n'
        ip route 2>&1
    } > "$report"
    "$DIALOG" --title 'Wi-Fi status' --textbox "$report" 22 38
    rm -f "$report"
}

while :; do
    choice=$("$DIALOG" --stdout --clear --cancel-label Close --title Wi-Fi \
        --menu 'Wireless network manager' 18 38 7 \
        connect 'Scan and connect' status 'Connection status' \
        disconnect 'Disconnect' radio_on 'Start radio' radio_off 'Stop radio') || break
    case "$choice" in
        connect) scan_networks ;;
        status) show_status ;;
        disconnect)
            output=$(rx1950-wlan disconnect 2>&1) && message Wi-Fi 'Disconnected.' || message Error "$output"
            ;;
        radio_on) ensure_radio && message Wi-Fi 'Radio is ready.' ;;
        radio_off)
            output=$(rx1950-wlan stop 2>&1) && message Wi-Fi 'Radio stopped.' || message Error "$output"
            ;;
    esac
done
rm -f /tmp/rx1950-ssid.$$ /tmp/rx1950-scan.$$ /tmp/rx1950-scan-error.$$
clear
