#!/bin/sh
# Reboot directly into the cable-update recovery stored on the boot partition.

set -eu
PATH=/sbin:/bin:/usr/sbin:/usr/bin

KERNEL=${1:-/mnt/boot/zImage}
INITRAMFS=${2:-/mnt/boot/recovery.cpio.gz}
CMDLINE='rdinit=/init console=tty0 loglevel=4 consoleblank=0'

[ "$(id -u)" -eq 0 ] || {
    echo 'rx1950-enter-recovery must run as root' >&2
    exit 1
}
[ -e /sys/kernel/kexec_loaded ] || {
    echo 'the running kernel has no kexec support; bootstrap the OTA kernel first' >&2
    exit 1
}
[ -s "$KERNEL" ] || { echo "missing recovery kernel: $KERNEL" >&2; exit 1; }
[ -s "$INITRAMFS" ] || { echo "missing recovery initramfs: $INITRAMFS" >&2; exit 1; }

kexec -l "$KERNEL" --type=zImage --initrd="$INITRAMFS" --append="$CMDLINE"
sync
kexec -e
