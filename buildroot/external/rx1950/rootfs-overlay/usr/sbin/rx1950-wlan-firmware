#!/bin/sh
# Manage the ACX100 firmware shipped in release images. Manual import remains
# available for recovery; fetch uses OpenBSD's historical package and verifies
# the exact firmware payloads before installing them.

set -u
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

DEST=/lib/firmware
BOOT=/dev/mmcblk0p1
MNT=/mnt/rx1950-boot
OPENBSD_URL=${RX1950_ACX_FIRMWARE_URL:-http://firmware.openbsd.org/firmware/7.7/acx-firmware-1.4p6.tgz}
MAIN_SHA256=3d92318dadef22b1d1b062925ef66bac2ad48a0fd4fc83b88dcabba38c182b7b
RADIO0D_SHA256=ee75c05bb8a17a7978abbbc0f38fb79b1915c1e2357889e65657a39024d5b3a3
RADIO11_SHA256=e005a93a0b463e01edba2b79038b54c29a7932efee61c851a2ac644b8a4e5dd4

say() { printf '%s\n' "$*"; }

verify_sha256() {
	file=$1
	expected=$2
	printf '%s  %s\n' "$expected" "$file" | sha256sum -c -s
}

find_boot_mount() {
	[ -r /proc/mounts ] || return 1
	while read -r device mountpoint _rest; do
		[ "$device" = "$BOOT" ] || continue
		printf '%s\n' "$mountpoint"
		return 0
	done < /proc/mounts
	return 1
}

install_main() {
	src=$1
	[ -r "$src" ] || return 1
	mkdir -p "$DEST"
	cp "$src" "$DEST/WLANGEN.BIN"
	chmod 0644 "$DEST/WLANGEN.BIN"
	return 0
}

install_radios_from_dir() {
	dir=$1
	installed=0
	for src in "$dir"/RADIO??.BIN "$dir"/radio??.bin; do
		[ -r "$src" ] || continue
		base="$(basename "$src")"
		suffix="$(printf '%s' "$base" | sed -n 's/^[Rr][Aa][Dd][Ii][Oo]\([0-9A-Fa-f][0-9A-Fa-f]\)\.[Bb][Ii][Nn]$/\1/p')"
		[ -n "$suffix" ] || continue
		suffix="$(printf '%s' "$suffix" | tr 'A-F' 'a-f')"
		cp "$src" "$DEST/RADIO${suffix}.BIN"
		chmod 0644 "$DEST/RADIO${suffix}.BIN"
		installed=1
	done

	for src in "$dir"/tiacx100r??; do
		[ -r "$src" ] || continue
		base="$(basename "$src")"
		suffix="${base#tiacx100r}"
		case "$suffix" in
			[0-9A-Fa-f][0-9A-Fa-f]) ;;
			*) continue ;;
		esac
		suffix="$(printf '%s' "$suffix" | tr 'A-F' 'a-f')"
		cp "$src" "$DEST/RADIO${suffix}.BIN"
		chmod 0644 "$DEST/RADIO${suffix}.BIN"
		installed=1
	done
	return $((1 - installed))
}

import_dir() {
	dir=$1
	mkdir -p "$DEST"
	main_ok=0
	radio_ok=0

	for src in "$dir"/WLANGEN.BIN "$dir"/wlangen.bin "$dir"/tiacx100; do
		if [ -r "$src" ] && install_main "$src"; then
			main_ok=1
			break
		fi
	done
	if install_radios_from_dir "$dir"; then
		radio_ok=1
	fi

	if [ "$main_ok" -eq 1 ] && [ "$radio_ok" -eq 1 ]; then
		sync
		say "ACX100 firmware installed in $DEST"
		return 0
	fi

	say "Firmware incomplete: need WLANGEN.BIN (or tiacx100) and at least one RADIOxx.BIN (or tiacx100rXX)" >&2
	return 1
}

import_boot() {
	mounted_here=0
	boot_dir="$(find_boot_mount 2>/dev/null || true)"
	if [ -z "$boot_dir" ]; then
		mkdir -p "$MNT"
		mount -t vfat -o ro "$BOOT" "$MNT" || return 1
		boot_dir="$MNT"
		mounted_here=1
	fi

	import_dir "$boot_dir"
	ret=$?
	[ "$mounted_here" -eq 0 ] || umount "$MNT" 2>/dev/null || true
	return "$ret"
}

fetch_openbsd() {
	command -v curl >/dev/null 2>&1 || { say "curl is unavailable" >&2; return 1; }
	command -v sha256sum >/dev/null 2>&1 || { say "sha256sum is unavailable" >&2; return 1; }
	tmp="/tmp/rx1950-acx-fw.$$"
	rm -rf "$tmp"
	mkdir -p "$tmp/unpack" "$tmp/selected"
	trap 'rm -rf "$tmp"' EXIT HUP INT TERM

	say "Downloading ACX100 firmware from OpenBSD..."
	curl --fail --location "$OPENBSD_URL" -o "$tmp/acx.tgz" || return 1
	tar -xzf "$tmp/acx.tgz" -C "$tmp/unpack" || return 1

	main="$(find "$tmp/unpack" -type f -name tiacx100 2>/dev/null | head -n 1)"
	radio0d="$(find "$tmp/unpack" -type f -name tiacx100r0D 2>/dev/null | head -n 1)"
	radio11="$(find "$tmp/unpack" -type f -name tiacx100r11 2>/dev/null | head -n 1)"
	[ -n "$main" ] && [ -n "$radio0d" ] && [ -n "$radio11" ] || {
		say "ACX100 firmware files not found in downloaded package" >&2
		return 1
	}

	verify_sha256 "$main" "$MAIN_SHA256" || { say "WLANGEN firmware checksum mismatch" >&2; return 1; }
	verify_sha256 "$radio0d" "$RADIO0D_SHA256" || { say "RADIO0d firmware checksum mismatch" >&2; return 1; }
	verify_sha256 "$radio11" "$RADIO11_SHA256" || { say "RADIO11 firmware checksum mismatch" >&2; return 1; }

	cp "$main" "$tmp/selected/tiacx100"
	cp "$radio0d" "$tmp/selected/tiacx100r0D"
	cp "$radio11" "$tmp/selected/tiacx100r11"
	import_dir "$tmp/selected"
}

status() {
	if [ -r "$DEST/WLANGEN.BIN" ]; then
		say "main: $DEST/WLANGEN.BIN"
	else
		say "main: missing"
	fi
	found=0
	for f in "$DEST"/RADIO??.BIN; do
		[ -r "$f" ] || continue
		found=1
		say "radio: $f"
	done
	[ "$found" -eq 1 ] || say "radio: missing"
}

case "${1:-status}" in
	status) status ;;
	import)
		if [ "$#" -ge 2 ]; then import_dir "$2"; else import_boot; fi
		;;
	fetch) fetch_openbsd ;;
	*)
		say "usage: rx1950-wlan-firmware {status|import [directory]|fetch}" >&2
		exit 2
		;;
esac
