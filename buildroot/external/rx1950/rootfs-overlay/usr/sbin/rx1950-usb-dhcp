#!/bin/sh
# Try optional host DHCP once.  The fixed 192.168.7.2 recovery address remains
# available when no DHCP server exists, so an idle retry supervisor would only
# waste scarce RAM.  After a successful lease udhcpc remains alive to renew it.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

SCRIPT=/usr/share/udhcpc/rx1950-usb.script
CLIENT_PID=/var/run/udhcpc-usb0-client.pid

ip link show usb0 >/dev/null 2>&1 || exit 0

# -n exits after the bounded discovery attempts when no server exists.
exec udhcpc -n -f -i usb0 -p "$CLIENT_PID" -s "$SCRIPT" \
    -t 3 -T 2 >/dev/null 2>&1
