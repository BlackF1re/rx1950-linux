#!/bin/sh
# Confirmation UI for destructive power operations. Suspend is immediate from
# the JWM menu because it does not discard data.

action=${1:-}
case "$action" in
    reboot) prompt='Restart the device now?' ;;
    poweroff) prompt='Power off the device now?' ;;
    '')
        action=$(dialog --stdout --cancel-label Close --title Power \
            --menu 'Select an action' 13 34 3 suspend Suspend reboot Restart poweroff 'Power off') || exit 0
        [ "$action" != suspend ] || exec rx1950-control suspend
        case "$action" in reboot) prompt='Restart the device now?';; poweroff) prompt='Power off the device now?';; esac
        ;;
    *) exit 2 ;;
esac
dialog --title Confirm --yesno "$prompt" 7 32 || exit 0
exec rx1950-control "$action"
