#!/bin/sh
# On-demand control centre.  dialog exits with this process, so it has no idle
# RAM cost and relies only on ncurses already required by xterm.

set -u
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH
DIALOG=dialog

message() {
    "$DIALOG" --clear --title "$1" --msgbox "$2" 14 36
}

brightness_menu() {
    backlight=
    for path in /sys/class/backlight/*; do
        [ -e "$path/max_brightness" ] || continue
        backlight=$path
        break
    done
    [ -n "$backlight" ] || {
        message Brightness 'No backlight device was found.'
        return
    }
    max=$(cat "$backlight/max_brightness")
    current=$(cat "$backlight/actual_brightness")
    choice=$("$DIALOG" --stdout --title "Brightness: $current/$max" \
        --menu 'Select level' 15 36 7 \
        10 '10 percent' 25 '25 percent' 40 '40 percent' \
        55 '55 percent' 75 '75 percent' 100 '100 percent') || return
    value=$((max * choice / 100))
    [ "$value" -gt 0 ] || value=1
    printf '%s\n' "$value" > "$backlight/brightness"
}

volume_menu() {
    choice=$("$DIALOG" --stdout --title Volume --menu 'Master output' 17 36 9 \
        20 'Quiet' 35 'Low' 50 'Medium' 65 'Normal' \
        80 'Loud' 100 'Maximum' mute 'Mute' test 'Test sound') || return
    case "$choice" in
        mute) amixer -q sset Master mute ;;
        test)
            amixer -q sset Master unmute
            speaker-test -q -t sine -f 1000 -l 1 >/dev/null 2>&1
            ;;
        *) amixer -q sset Master "$choice%" unmute ;;
    esac
}

keyboard_menu() {
    current=$(rx1950-keyboard status)
    choice=$("$DIALOG" --stdout --title "Keyboard: $current" \
        --menu 'Select layout' 18 36 10 \
        us 'English (US)' ru 'Russian' fr 'French' fi 'Finnish' \
        dvorak 'Dvorak' extended 'Extended' numpad 'Numeric') || return
    rx1950-keyboard layout "$choice"
    message Keyboard "Layout changed to $choice. Use the keyboard tray button to show or hide it."
}

clock_menu() {
    current=$(rx1950-timezone 2>/dev/null || printf 'Etc/UTC')
    zone=$("$DIALOG" --stdout --title "Timezone: $current" \
        --inputbox 'Zoneinfo name (for example Asia/Tomsk)' 10 36 "$current") || return
    if output=$(rx1950-timezone "$zone" 2>&1); then
        message Clock "$output"
    else
        message Error "$output"
    fi
}

system_status() {
    report=/tmp/rx1950-status.$$
    {
        uname -a
        printf '\nMemory and swap:\n'
        free -h
        printf '\nStorage:\n'
        df -h
        printf '\nNetwork:\n'
        ip -br addr 2>/dev/null || ip addr
        printf '\nBattery and sensors:\n'
        rx1950-sensors 2>&1 || true
    } > "$report"
    "$DIALOG" --title 'System status' --textbox "$report" 24 38
    rm -f "$report"
}

power_menu() {
    choice=$("$DIALOG" --stdout --title Power --menu 'Power action' 12 34 3 \
        reboot 'Restart the PDA' poweroff 'Shut down' cancel 'Go back') || return
    case "$choice" in
        reboot|poweroff)
            "$DIALOG" --title Confirm --yesno "Really $choice?" 8 32 || return
            "$choice"
            ;;
    esac
}

while :; do
    choice=$("$DIALOG" --stdout --clear --cancel-label Close \
        --title 'rx1950 Control Center' --menu 'Choose a setting' 22 38 11 \
        wifi 'Wi-Fi networks' brightness 'Screen brightness' \
        volume 'Sound and volume' keyboard 'On-screen keyboard' \
        clock 'Timezone' sync 'Synchronize clock' \
        status 'System status' calibrate 'Touch calibration' \
        power 'Restart or shut down') || break
    case "$choice" in
        wifi) rx1950-wifi-ui ;;
        brightness) brightness_menu ;;
        volume) volume_menu ;;
        keyboard) keyboard_menu ;;
        clock) clock_menu ;;
        sync)
            "$DIALOG" --infobox 'Synchronizing clock...' 5 30
            if rx1950-time-sync; then message Clock 'Clock synchronized.'; else message Error 'Clock synchronization failed.'; fi
            ;;
        status) system_status ;;
        calibrate)
            message Calibration 'The measured affine calibration is active. The calibration tool will now open; its result is temporary and intended for checking only.'
            xinput_calibrator
            ;;
        power) power_menu ;;
    esac
done
clear
