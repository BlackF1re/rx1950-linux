#!/bin/sh
# Control the RX1950 ACX100 WLAN stack without assuming a deployment country.
set -eu
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

PIDFILE=/var/run/wpa_supplicant-rx1950.pid
DHCP_PIDFILE=/var/run/udhcpc-wlan.pid
CONF=/etc/wpa_supplicant.conf
BLUE_TRIGGER=/sys/class/leds/Blue/trigger
LOCKDIR=/run/rx1950-wlan.lock
REGDOMAIN=
POWER_MODE=historical
[ ! -r /etc/default/rx1950-wlan ] || . /etc/default/rx1950-wlan

acquire_lock() {
    mkdir "$LOCKDIR" 2>/dev/null || { echo 'another rx1950-wlan operation is in progress' >&2; return 1; }
    trap 'rmdir "$LOCKDIR" 2>/dev/null || true' EXIT HUP INT TERM
}
iface() {
    for n in /sys/class/net/wlan*; do [ -e "$n" ] && { basename "$n"; return 0; }; done
    return 1
}
firmware_ready() {
    [ -r /lib/firmware/WLANGEN.BIN ] || return 1
    for f in /lib/firmware/RADIO??.BIN; do [ -r "$f" ] && return 0; done
    return 1
}
loaded_gpa11_mode() {
    [ -r /sys/module/rx1950_acx/parameters/gpa11_power ] || return 1
    cat /sys/module/rx1950_acx/parameters/gpa11_power
}
prepare_shared_power_trigger() {
    [ -w "$BLUE_TRIGGER" ] || { echo 'Blue LED trigger control unavailable' >&2; return 1; }
    printf '%s\n' none > "$BLUE_TRIGGER"
}
verify_shared_power_trigger() {
    [ -r "$BLUE_TRIGGER" ] || return 1
    case "$(cat "$BLUE_TRIGGER" 2>/dev/null)" in *'[rx1950-acx-mem]'*) return 0 ;; esac
    echo 'rx1950-acx-mem did not attach to the shared Blue/GPA11 line' >&2
    return 1
}
apply_regdomain() {
    country=$(printf '%s' "${REGDOMAIN:-}" | tr 'a-z' 'A-Z')
    [ -n "$country" ] || return 0
    case "$country" in [A-Z][A-Z]) iw reg set "$country" ;; *) echo "invalid REGDOMAIN: $REGDOMAIN" >&2; return 2 ;; esac
}

start_radio() {
    mode=${1:-${POWER_MODE:-historical}}
    firmware_ready || { echo 'ACX100 firmware is missing' >&2; return 1; }
    case "$mode" in historical|default) requested=Y ;; no-gpa11-power|independent) requested=N ;; *) echo "unknown start mode: $mode" >&2; return 2 ;; esac

    if current=$(loaded_gpa11_mode 2>/dev/null); then
        case "$current" in Y|y|1) current=Y ;; *) current=N ;; esac
        [ "$current" = "$requested" ] || { echo 'WLAN is loaded with a different GPA11 mode; restart it first' >&2; return 1; }
    else
        modprobe acx-mac80211 watchdog=1 || return 1
        if [ "$requested" = Y ]; then
            prepare_shared_power_trigger || { modprobe -r acx-mac80211 2>/dev/null || true; return 1; }
            modprobe rx1950_acx || { modprobe -r acx-mac80211 2>/dev/null || true; return 1; }
            verify_shared_power_trigger || { modprobe -r rx1950_acx 2>/dev/null || true; modprobe -r acx-mac80211 2>/dev/null || true; return 1; }
        else
            echo 'DIAGNOSTIC: starting WLAN without the historical GPA11 power line' >&2
            modprobe rx1950_acx gpa11_power=0 || { modprobe -r acx-mac80211 2>/dev/null || true; return 1; }
        fi
    fi

    attempt=0
    while [ "$attempt" -lt 20 ]; do
        ifname=$(iface 2>/dev/null || true); [ -n "$ifname" ] && break
        attempt=$((attempt + 1)); sleep 1
    done
    ifname=$(iface 2>/dev/null || true)
    [ -n "$ifname" ] || { echo 'ACX modules loaded but no wlan interface appeared' >&2; return 1; }
    apply_regdomain
    ip link set "$ifname" up
    echo "WLAN ready: $ifname"
}

disconnect_radio() {
    ifname=$(iface 2>/dev/null || true)
    if [ -s "$DHCP_PIDFILE" ]; then pid=$(cat "$DHCP_PIDFILE" 2>/dev/null || true); [ -z "$pid" ] || kill "$pid" 2>/dev/null || true; fi
    rm -f "$DHCP_PIDFILE"
    if [ -s "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null || true)
        [ -z "$ifname" ] || wpa_cli -i "$ifname" terminate >/dev/null 2>&1 || true
        [ -z "$pid" ] || kill "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
    [ -z "$ifname" ] || ip addr flush dev "$ifname" 2>/dev/null || true
}

stop_radio() {
    disconnect_radio
    ifname=$(iface 2>/dev/null || true)
    [ -z "$ifname" ] || { ip link set "$ifname" down 2>/dev/null || true; sleep 1; }
    modprobe -r rx1950_acx 2>/dev/null || true
    modprobe -r acx-mac80211 2>/dev/null || true
}

scan_radio() {
    ifname=$(iface 2>/dev/null || true)
    [ -n "$ifname" ] || { start_radio; ifname=$(iface); }
    ip link set "$ifname" up
    apply_regdomain
    iw dev "$ifname" scan
}

connect_radio() {
    ifname=$(iface 2>/dev/null || true)
    [ -n "$ifname" ] || { start_radio; ifname=$(iface); }
    [ -r "$CONF" ] || { echo "missing $CONF" >&2; return 1; }
    disconnect_radio
    ip link set "$ifname" up
    # The ACX100 firmware cannot carry modern nl80211 probe-request IEs; the
    # driver's WEXT compatibility path is the reliable association backend.
    wpa_supplicant -B -D wext -P "$PIDFILE" -i "$ifname" -c "$CONF" || return 1
    attempt=0
    while [ "$attempt" -lt 20 ]; do
        wpa_cli -i "$ifname" status 2>/dev/null | grep -qx 'wpa_state=COMPLETED' && break
        attempt=$((attempt + 1)); sleep 1
    done
    [ "$attempt" -lt 20 ] || { echo 'Wi-Fi association timed out' >&2; disconnect_radio; return 1; }
    udhcpc -i "$ifname" -p "$DHCP_PIDFILE" -n -q -t 5 -T 2 -A 5 || { echo 'associated, but DHCP failed' >&2; return 1; }
    if command -v rx1950-time-sync >/dev/null 2>&1 && ! pidof rx1950-time-sync >/dev/null 2>&1; then rx1950-time-sync >/dev/null 2>&1 & fi
}

status_radio() {
    echo '=== modules ==='; lsmod | grep -E '(^| )(rx1950_acx|acx_mac80211)( |$)' || true
    echo '=== wiring mode ==='; loaded_gpa11_mode 2>/dev/null || echo 'not loaded'
    echo '=== regulatory domain ==='; iw reg get 2>/dev/null | sed -n 's/^country \([^:]*\):.*/\1/p' | head -1 || true
    echo '=== firmware ==='; rx1950-wlan-firmware status
    echo '=== interface ==='; ifname=$(iface 2>/dev/null || true); [ -z "$ifname" ] && echo none || { ip -details link show "$ifname"; iw dev "$ifname" info 2>/dev/null || true; }
}

acquire_lock || exit 1
case "${1:-status}" in
    start) start_radio "${2:-${POWER_MODE:-historical}}" ;;
    stop) stop_radio ;;
    restart) stop_radio; start_radio "${2:-${POWER_MODE:-historical}}" ;;
    status) status_radio ;;
    scan) scan_radio ;;
    connect) connect_radio ;;
    disconnect) disconnect_radio ;;
    *) echo 'usage: rx1950-wlan {start [historical|no-gpa11-power]|stop|restart [mode]|status|scan|connect|disconnect}' >&2; exit 2 ;;
esac
