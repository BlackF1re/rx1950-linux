#!/bin/sh
# Control the optional RX1950 ACX100 WLAN modules.
#
# The default mode follows the historical RX1950 wiring, including GPA11,
# which is shared with the visible Blue LED. no-gpa11-power is a diagnostic
# mode for testing whether this particular device can run the radio without
# that shared line.

set -u
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

PIDFILE=/var/run/wpa_supplicant-rx1950.pid
CONF=/etc/wpa_supplicant.conf
BLUE_TRIGGER=/sys/class/leds/Blue/trigger
LOCKDIR=/run/rx1950-wlan.lock
REGDOMAIN=RU
[ ! -r /etc/default/rx1950-wlan ] || . /etc/default/rx1950-wlan

acquire_lock() {
	mkdir "$LOCKDIR" 2>/dev/null || {
		printf '%s\n' 'another rx1950-wlan operation is in progress' >&2
		return 1
	}
	trap 'rmdir "$LOCKDIR" 2>/dev/null || true' EXIT HUP INT TERM
}

iface() {
	for n in /sys/class/net/wlan*; do
		[ -e "$n" ] || continue
		basename "$n"
		return 0
	done
	return 1
}

firmware_ready() {
	[ -r /lib/firmware/WLANGEN.BIN ] || return 1
	for f in /lib/firmware/RADIO??.BIN; do
		[ -r "$f" ] && return 0
	done
	return 1
}

loaded_gpa11_mode() {
	[ -r /sys/module/rx1950_acx/parameters/gpa11_power ] || return 1
	cat /sys/module/rx1950_acx/parameters/gpa11_power
}

prepare_shared_power_trigger() {
	[ -w "$BLUE_TRIGGER" ] || {
		printf '%s\n' 'Blue LED trigger control is unavailable; refusing historical GPA11 power mode.' >&2
		return 1
	}
	# The kernel only attaches a newly registered default trigger when the LED
	# has no active trigger. Detach any userspace-selected trigger before the
	# rx1950_acx module registers rx1950-acx-mem.
	printf '%s\n' none > "$BLUE_TRIGGER" || return 1
}

verify_shared_power_trigger() {
	[ -r "$BLUE_TRIGGER" ] || return 1
	case "$(cat "$BLUE_TRIGGER" 2>/dev/null)" in
		*'[rx1950-acx-mem]'*) return 0 ;;
		*)
			printf '%s\n' 'rx1950-acx-mem did not attach to the shared Blue/GPA11 line.' >&2
			return 1
			;;
	esac
}

start_radio() {
	mode=${1:-historical}
	firmware_ready || {
		printf '%s\n' 'ACX100 firmware is missing. Run: rx1950-wlan-firmware import  (or fetch)' >&2
		return 1
	}

	case "$mode" in
		historical|default) requested=Y ;;
		no-gpa11-power|independent) requested=N ;;
		*) printf '%s\n' "unknown start mode: $mode" >&2; return 2 ;;
	esac

	if current="$(loaded_gpa11_mode 2>/dev/null)"; then
		case "$current" in
			Y|y|1) current=Y ;;
			*) current=N ;;
		esac
		if [ "$current" != "$requested" ]; then
			printf '%s\n' 'RX1950 WLAN is already loaded in a different GPA11 mode.' >&2
			printf '%s\n' 'Run rx1950-wlan restart with the desired mode.' >&2
			return 1
		fi
	else
		modprobe acx-mac80211 watchdog=1 || return 1
		case "$requested" in
			Y)
				# Historical RX1950 sequence: GPA11 is the WLAN power/Blue line.
				prepare_shared_power_trigger || {
					modprobe -r acx-mac80211 2>/dev/null || true
					return 1
				}
				modprobe rx1950_acx || {
					modprobe -r acx-mac80211 2>/dev/null || true
					return 1
				}
				if ! verify_shared_power_trigger; then
					modprobe -r rx1950_acx 2>/dev/null || true
					modprobe -r acx-mac80211 2>/dev/null || true
					return 1
				fi
				;;
			N)
				printf '%s\n' 'DIAGNOSTIC: WLAN is starting without the historical GPA11 power/Blue line.' >&2
				modprobe rx1950_acx gpa11_power=0 || {
					modprobe -r acx-mac80211 2>/dev/null || true
					return 1
				}
				;;
		esac
	fi

	attempt=0
	while [ "$attempt" -lt 20 ]; do
		ifname="$(iface 2>/dev/null || true)"
		[ -n "$ifname" ] && break
		attempt=$((attempt + 1))
		sleep 1
	done
	ifname="$(iface 2>/dev/null || true)"
	[ -n "$ifname" ] || {
		printf '%s\n' 'ACX modules loaded but no wlan interface appeared.' >&2
		printf '%s\n' 'Inspect: dmesg | grep -iE "rx1950-acx|acx|firmware|wlan"' >&2
		return 1
	}
	case "$REGDOMAIN" in
		[A-Z][A-Z]) iw reg set "$REGDOMAIN" || return 1 ;;
		*) printf '%s\n' "invalid REGDOMAIN: $REGDOMAIN" >&2; return 1 ;;
	esac
	ip link set "$ifname" up
	# A wlan netdev can exist while the ACX command engine is already wedged.
	# Require one complete bounded scan before claiming that the radio is ready.
	if ! timeout 20 iw dev "$ifname" scan >/run/rx1950-wlan-scan.log 2>&1; then
		printf '%s\n' 'ACX radio health scan failed; interface is not ready.' >&2
		return 1
	fi
	printf '%s\n' "WLAN ready: $ifname"
}

stop_radio() {
	if [ -s "$PIDFILE" ]; then
		pid="$(cat "$PIDFILE" 2>/dev/null || true)"
		ifname="$(iface 2>/dev/null || true)"
		[ -z "$ifname" ] || wpa_cli -i "$ifname" terminate >/dev/null 2>&1 || true
		attempt=0
		while [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ "$attempt" -lt 5 ]; do
			sleep 1
			attempt=$((attempt + 1))
		done
		[ -z "$pid" ] || kill "$pid" 2>/dev/null || true
		rm -f "$PIDFILE"
	fi
	ifname="$(iface 2>/dev/null || true)"
	if [ -n "$ifname" ]; then
		ip link set "$ifname" down || return 1
		sleep 1
	fi
	modprobe -r rx1950_acx || return 1
	modprobe -r acx-mac80211 || return 1
}

status_radio() {
	printf '%s\n' '=== modules ==='
	lsmod | grep -E '(^| )(rx1950_acx|acx_mac80211)( |$)' || true
	printf '%s\n' '=== wiring mode ==='
	if current="$(loaded_gpa11_mode 2>/dev/null)"; then
		case "$current" in
			Y|y|1) printf '%s\n' 'historical (GPA11 WLAN power / Blue shared)' ;;
			*) printf '%s\n' 'diagnostic no-gpa11-power' ;;
		esac
	else
		printf '%s\n' 'not loaded'
	fi
	printf '%s\n' '=== firmware ==='
	rx1950-wlan-firmware status
	printf '%s\n' '=== interface ==='
	ifname="$(iface 2>/dev/null || true)"
	if [ -n "$ifname" ]; then
		ip -details link show "$ifname"
		iw dev "$ifname" info 2>/dev/null || true
	else
		printf '%s\n' 'none'
	fi
}

scan_radio() {
	ifname="$(iface 2>/dev/null || true)"
	[ -n "$ifname" ] || { printf '%s\n' 'no wlan interface' >&2; return 1; }
	ip link set "$ifname" up || return 1
	iw dev "$ifname" scan
}

connect_radio() {
	ifname="$(iface 2>/dev/null || true)"
	[ -n "$ifname" ] || { printf '%s\n' 'no wlan interface' >&2; return 1; }
	[ -r "$CONF" ] || {
		printf '%s\n' "create $CONF first (for example with wpa_passphrase)" >&2
		return 1
	}
	if [ -s "$PIDFILE" ]; then
		pid="$(cat "$PIDFILE" 2>/dev/null || true)"
		[ -z "$pid" ] || kill "$pid" 2>/dev/null || true
	fi
	rm -f "$PIDFILE"
	ip link set "$ifname" up || return 1
	wpa_supplicant -B -P "$PIDFILE" -i "$ifname" -c "$CONF" || return 1
	udhcpc -i "$ifname" -b -t 5 -T 2 -A 5 >/dev/null 2>&1
}

acquire_lock || exit 1
case "${1:-status}" in
	start) start_radio "${2:-historical}" ;;
	stop) stop_radio ;;
	restart) stop_radio; start_radio "${2:-historical}" ;;
	status) status_radio ;;
	scan) scan_radio ;;
	connect) connect_radio ;;
	*)
		printf '%s\n' 'usage: rx1950-wlan {start [historical|no-gpa11-power]|stop|restart [historical|no-gpa11-power]|status|scan|connect}' >&2
		exit 2
		;;
esac
