#!/bin/sh
# Persistent, device-visible milestones and diagnostic snapshots for first boot.

set -u

BOOT_DEVICE=/dev/mmcblk0p1
BOOT_MOUNT=/mnt/boot
LOG_FILE=${BOOT_MOUNT}/probe.log
DMESG_FILE=${BOOT_MOUNT}/dmesg.log
DIAG_FILE=${BOOT_MOUNT}/diagnostics.txt

mount_boot() {
    mkdir -p "$BOOT_MOUNT"
    if ! grep -q " $BOOT_MOUNT " /proc/mounts; then
        mount -t vfat -o rw "$BOOT_DEVICE" "$BOOT_MOUNT" 2>/dev/null || true
    fi
    grep -q " $BOOT_MOUNT " /proc/mounts
}

record() {
    message="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown-time) $*"
    printf '%s\n' "$message" > /dev/kmsg 2>/dev/null || true
    printf '%s\n' "$message" >&2

    if mount_boot; then
        printf '%s\n' "$message" >> "$LOG_FILE"
        sync "$LOG_FILE" 2>/dev/null || sync
    fi
}

set_backlight_max() {
    found=0
    for backlight in /sys/class/backlight/*; do
        [ -d "$backlight" ] || continue
        found=1
        max="$(cat "$backlight/max_brightness" 2>/dev/null || true)"
        if [ -n "$max" ] && [ -w "$backlight/brightness" ]; then
            printf '%s\n' "$max" > "$backlight/brightness" 2>/dev/null || true
        fi
    done
    return $((found == 0))
}

snapshot_backlight() {
    printf '%s\n' '=== backlight ==='
    found=0
    for backlight in /sys/class/backlight/*; do
        [ -d "$backlight" ] || continue
        found=1
        printf 'device=%s\n' "$(basename "$backlight")"
        for field in brightness actual_brightness max_brightness bl_power type; do
            if [ -r "$backlight/$field" ]; then
                printf '%s=' "$field"
                cat "$backlight/$field" 2>/dev/null || true
            fi
        done
    done
    [ "$found" -eq 1 ] || printf '%s\n' 'none'
}

snapshot_usb() {
    printf '%s\n' '=== usb gadget ==='
    found=0
    for udc in /sys/class/udc/*; do
        [ -e "$udc" ] || continue
        found=1
        printf 'udc=%s\n' "$(basename "$udc")"
        for field in state function; do
            if [ -r "$udc/$field" ]; then
                printf '%s=' "$field"
                cat "$udc/$field" 2>/dev/null || true
            fi
        done
    done
    [ "$found" -eq 1 ] || printf '%s\n' 'udc=none'

    printf '%s\n' '=== network interfaces ==='
    ip -details link show 2>/dev/null || true
    ip address show 2>/dev/null || true

    printf '%s\n' '=== usb platform devices ==='
    for device in /sys/bus/platform/devices/*usb*; do
        [ -e "$device" ] || continue
        printf '%s\n' "$(basename "$device")"
    done
}

snapshot_kernel() {
    mount_boot || return 0

    dmesg > "$DMESG_FILE" 2>/dev/null || true
    {
        printf '%s\n' '=== rx1950 boot diagnostics ==='
        printf '%s\n' '=== cmdline ==='
        cat /proc/cmdline 2>/dev/null || true
        printf '%s\n' '=== uptime ==='
        cat /proc/uptime 2>/dev/null || true
        snapshot_backlight
        snapshot_usb
        printf '%s\n' '=== interrupts ==='
        cat /proc/interrupts 2>/dev/null || true
        printf '%s\n' '=== iomem ==='
        cat /proc/iomem 2>/dev/null || true
        printf '%s\n' '=== ioports ==='
        cat /proc/ioports 2>/dev/null || true
        printf '%s\n' '=== mounts ==='
        cat /proc/mounts 2>/dev/null || true
        printf '%s\n' '=== devices ==='
        cat /proc/devices 2>/dev/null || true
        printf '%s\n' '=== modules ==='
        cat /proc/modules 2>/dev/null || true
    } > "$DIAG_FILE"
    sync "$DMESG_FILE" "$DIAG_FILE" 2>/dev/null || sync
}

set_led() {
    led="$1"
    value="$2"
    brightness="/sys/class/leds/$led/brightness"
    [ -w "$brightness" ] && printf '%s\n' "$value" > "$brightness"
}

case "${1:-}" in
    early-userspace)
        set_backlight_max || true
        set_led Green 1
        record "early-userspace-reached"
        snapshot_kernel
        ;;
    rootfs-ready)
        set_backlight_max || true
        set_led Blue 1
        record "rootfs-ready"
        snapshot_kernel
        ;;
    usb-network-ready|usb0-unavailable)
        set_backlight_max || true
        record "$1"
        snapshot_kernel
        ;;
    *)
        set_backlight_max || true
        record "unknown-probe-event:${1:-none}"
        snapshot_kernel
        ;;
esac
