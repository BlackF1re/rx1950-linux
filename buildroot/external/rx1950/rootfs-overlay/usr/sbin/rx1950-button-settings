#!/bin/sh
# On-demand mapping for the PDA's application buttons.  JWM provides the
# settings hierarchy; this small hardware adapter exits immediately after use.

set -u
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

DIALOG=dialog

choose_action() {
    key=$1
    label=$2
    action=$("$DIALOG" --stdout --title "$label" --menu 'Assign action' 19 38 10 \
        terminal 'Terminal' editor 'Text editor' calculator 'Calculator' \
        wifi 'Wi-Fi manager' keyboard 'On-screen keyboard' \
        status 'System status' suspend 'Suspend' power 'Power menu' \
        none 'No action') || return 1

    case "$action" in
        terminal) command='/usr/bin/rx1950-launch --name terminal /usr/bin/mb-applet-xterm-wrapper.sh' ;;
        editor) command='/usr/bin/rx1950-launch --name editor /usr/bin/xedit' ;;
        calculator) command='/usr/bin/rx1950-launch --name calculator /usr/bin/xcalc' ;;
        wifi) command='/usr/bin/rx1950-wifi-launcher' ;;
        keyboard) command='/usr/bin/rx1950-keyboard toggle' ;;
        status) command='/usr/bin/rx1950-launch --name diagnostics /usr/bin/mb-applet-xterm-wrapper.sh -hold -e /usr/sbin/rx1950-control status' ;;
        suspend) command='/usr/sbin/rx1950-control suspend' ;;
        power) command='/usr/bin/rx1950-launch --name power /usr/bin/mb-applet-xterm-wrapper.sh -e /usr/sbin/rx1950-power-menu' ;;
        none) command= ;;
        *) return 1 ;;
    esac
    rx1950-control key-set "$key" "$command"
}

while :; do
    key=$("$DIALOG" --stdout --cancel-label Close --title 'Hardware buttons' \
        --menu 'Choose a button' 17 38 7 \
        KEY_POWER 'Power button' KEY_F1 'Application 1' \
        KEY_F2 'Application 2' KEY_F3 'Application 3' \
        KEY_F4 'Application 4' KEY_F5 'Keyboard button') || break
    choose_action "$key" "$key" || continue
    rx1950-control key-reload
done
clear
