#!/bin/sh
# Add a host-provided DHCP lease to usb0 without removing the fixed recovery
# address 192.168.7.2.  This lets Windows Internet Connection Sharing provide
# a second address/default route while the deterministic recovery link remains.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

LEASE_FILE=/var/run/rx1950-usb-dhcp.addr
RESOLV_CONF=/etc/resolv.conf
TAG='# rx1950-usb-dhcp'

mask_prefix() {
    old_ifs="$IFS"
    IFS=.
    set -- ${1:-255.255.255.0}
    IFS="$old_ifs"
    bits=0
    for octet in "$@"; do
        case "$octet" in
            255) bits=$((bits + 8)) ;;
            254) bits=$((bits + 7)) ;;
            252) bits=$((bits + 6)) ;;
            248) bits=$((bits + 5)) ;;
            240) bits=$((bits + 4)) ;;
            224) bits=$((bits + 3)) ;;
            192) bits=$((bits + 2)) ;;
            128) bits=$((bits + 1)) ;;
            0) ;;
            *) return 1 ;;
        esac
    done
    printf '%s\n' "$bits"
}

clear_dynamic_state() {
    old="$(cat "$LEASE_FILE" 2>/dev/null || true)"
    if [ -n "$old" ]; then
        ip address del "$old" dev "$interface" 2>/dev/null || true
        rm -f "$LEASE_FILE"
    fi
    ip route del default dev "$interface" metric 50 2>/dev/null || true

    if [ -f "$RESOLV_CONF" ]; then
        tmp="${RESOLV_CONF}.rx1950.$$"
        grep -vF "$TAG" "$RESOLV_CONF" > "$tmp" 2>/dev/null || true
        cat "$tmp" > "$RESOLV_CONF"
        rm -f "$tmp"
    fi
}

case "${1:-}" in
    deconfig)
        clear_dynamic_state
        ip link set "$interface" up 2>/dev/null || true
        ;;
    bound|renew)
        prefix="$(mask_prefix "${subnet:-255.255.255.0}")" || prefix=24
        lease_addr="${ip}/${prefix}"
        old="$(cat "$LEASE_FILE" 2>/dev/null || true)"
        if [ -n "$old" ] && [ "$old" != "$lease_addr" ]; then
            ip address del "$old" dev "$interface" 2>/dev/null || true
        fi
        ip address replace "$lease_addr" dev "$interface"
        printf '%s\n' "$lease_addr" > "$LEASE_FILE"

        if [ -n "${router:-}" ]; then
            set -- $router
            ip route replace default via "$1" dev "$interface" metric 50
        fi

        if [ -f "$RESOLV_CONF" ]; then
            tmp="${RESOLV_CONF}.rx1950.$$"
            grep -vF "$TAG" "$RESOLV_CONF" > "$tmp" 2>/dev/null || true
            cat "$tmp" > "$RESOLV_CONF"
            rm -f "$tmp"
        else
            : > "$RESOLV_CONF"
        fi
        for server in ${dns:-}; do
            printf 'nameserver %s %s\n' "$server" "$TAG" >> "$RESOLV_CONF"
        done
        printf 'rx1950-usb-dhcp: lease=%s router=%s dns=%s\n' \
            "$lease_addr" "${router:-none}" "${dns:-none}" > /dev/kmsg 2>/dev/null || true
        ;;
    leasefail|nak)
        # Keep the fixed 192.168.7.2 recovery address; DHCP is optional.
        ;;
esac

exit 0
