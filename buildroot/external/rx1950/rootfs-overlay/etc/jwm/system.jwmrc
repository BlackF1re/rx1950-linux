<?xml version="1.0"?>
<JWM>
  <!-- Applications are discovered from XDG .desktop files at menu-open time. -->
  <RootMenu onroot="1" height="32">
    <Dynamic label="Applications">exec:/usr/bin/rx1950-jwm-app-menu</Dynamic>
    <Separator/>
    <Program label="Settings">rx1950-launch --name settings rx1950-settings</Program>
    <Program label="Wi-Fi">rx1950-launch --name settings rx1950-settings wifi</Program>
    <Program label="Power / battery">rx1950-launch --name settings rx1950-settings power</Program>
    <Separator/>
    <Restart label="Reload desktop"/>
  </RootMenu>

  <!-- PDA-oriented defaults for the programs shipped in the base image. This
       is window policy, not the application menu; users may edit ~/.jwmrc. -->
  <Group>
    <Name>xterm</Name>
    <Name>xcalc</Name>
    <Name>leafpad</Name>
    <Name>pcmanfm</Name>
    <Name>dillo</Name>
    <Name>rx1950-settings</Name>
    <Name>xinput_calibrator</Name>
    <Option>maximized</Option>
  </Group>

  <Group>
    <Name>matchbox-keyboard</Name>
    <Option>layer:above</Option>
    <Option>nofocus</Option>
    <Option>nolist</Option>
    <Option>notitle</Option>
    <Option>sticky</Option>
  </Group>

  <!-- The lower tray is generated from /etc/default/rx1950-ui and can be
       changed from Settings without rewriting the rest of the JWM config. -->
  <Include>/root/.config/jwm/panel</Include>
  <Include>/root/.config/jwm/theme</Include>

  <Desktops width="1" height="1">
    <Background type="solid">#d8e8f6</Background>
  </Desktops>
  <DoubleClickSpeed>400</DoubleClickSpeed>
  <DoubleClickDelta>4</DoubleClickDelta>
  <FocusModel>click</FocusModel>
  <SnapMode distance="8">border</SnapMode>
  <MoveMode>outline</MoveMode>
  <ResizeMode>outline</ResizeMode>
  <Key key="Up">up</Key>
  <Key key="Down">down</Key>
  <Key key="Left">left</Key>
  <Key key="Right">right</Key>
  <Key key="Return">select</Key>
  <Key key="Escape">escape</Key>
  <Key mask="A" key="Tab">nextstacked</Key>
  <Key mask="A" key="F4">close</Key>
  <Key mask="A" key="F1">root:1</Key>
</JWM>
