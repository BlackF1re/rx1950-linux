#!/bin/sh
# Install the kernel-matched optional module bundle carried on the FAT boot
# partition.  Keeping these modules outside zImage preserves the proven SD boot
# path even when an experimental peripheral driver fails.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

BOOT=/dev/mmcblk0p1
MNT=/mnt/rx1950-boot
BUNDLE=kernel-modules.tar

log() {
	printf '%s\n' "rx1950-modules: $*" > /dev/kmsg 2>/dev/null || true
}

install_bundle() {
	krel="$(uname -r)"
	if [ -r "/lib/modules/$krel/extra/acx-mac80211.ko" ] && \
	   [ -r "/lib/modules/$krel/extra/rx1950_acx.ko" ]; then
		depmod -a "$krel" 2>/dev/null || true
		return 0
	fi

	[ -b "$BOOT" ] || { log "$BOOT is unavailable"; return 0; }
	mkdir -p "$MNT"
	mounted_here=0
	if ! grep -q " $MNT " /proc/mounts 2>/dev/null; then
		mount -t vfat -o ro "$BOOT" "$MNT" 2>/dev/null || {
			log "cannot mount boot partition"
			return 0
		}
		mounted_here=1
	fi

	if [ -r "$MNT/$BUNDLE" ]; then
		if tar -xf "$MNT/$BUNDLE" -C /; then
			depmod -a "$krel" 2>/dev/null || true
			mkdir -p /var/lib/rx1950
			printf 'kernel=%s\n' "$krel" > /var/lib/rx1950/kernel-modules-installed
			log "installed optional modules for $krel"
		else
			log "failed to extract $BUNDLE"
		fi
	else
		log "$BUNDLE is missing from boot partition"
	fi

	[ "$mounted_here" -eq 0 ] || umount "$MNT" 2>/dev/null || true
}

case "${1:-start}" in
	start) install_bundle ;;
	stop) : ;;
esac
