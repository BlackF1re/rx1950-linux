#!/bin/sh
# Start the single JWM session after the framebuffer X server.

export DISPLAY=:0.0 HOME=/root
PIDFILE=/run/jwm.pid
LOGFILE=/tmp/jwm.log

case "${1:-start}" in
    start)
        attempts=0
        while [ ! -S /tmp/.X11-unix/X0 ] && [ "$attempts" -lt 10 ]; do
            sleep 1
            attempts=$((attempts + 1))
        done
        [ -S /tmp/.X11-unix/X0 ] || exit 0
        rm -rf /run/rx1950-app.*
        jwm -f /etc/jwm/system.jwmrc >"$LOGFILE" 2>&1 &
        echo $! > "$PIDFILE"
        if [ -r /etc/default/rx1950-power ]; then
            . /etc/default/rx1950-power
            case "${BLANK_SECONDS:-60}" in
                0) xset s off ;;
                *[!0-9]*) xset s 60 60 ;;
                *) xset s "$BLANK_SECONDS" "$BLANK_SECONDS" ;;
            esac
        fi
        ;;
    stop)
        rx1950-keyboard hide 2>/dev/null || true
        if [ -s "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE")" 2>/dev/null || true
        fi
        rm -f "$PIDFILE"
        ;;
esac
