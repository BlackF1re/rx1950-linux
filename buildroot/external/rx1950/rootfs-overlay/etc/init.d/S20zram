#!/bin/sh
# Add a small compressed swap tier without consuming memory up front.

case "${1:-start}" in
    start)
        [ -e /sys/block/zram0/disksize ] || exit 0
        grep -q '^/dev/zram0 ' /proc/swaps 2>/dev/null && exit 0
        if [ -w /sys/block/zram0/comp_algorithm ]; then
            echo lzo-rle > /sys/block/zram0/comp_algorithm || exit 1
        fi
        # Twelve logical MiB is enough to absorb GUI/network pressure while
        # bounding metadata and incompressible-page cost on a 32 MiB machine.
        echo 12M > /sys/block/zram0/disksize || exit 1
        mkswap /dev/zram0 >/dev/null || exit 1
        swapon -p 100 /dev/zram0
        ;;
    stop)
        swapoff /dev/zram0 2>/dev/null || true
        [ ! -w /sys/block/zram0/reset ] || echo 1 > /sys/block/zram0/reset
        ;;
esac
