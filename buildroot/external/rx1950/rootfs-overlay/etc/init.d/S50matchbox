#!/bin/sh
# Start the minimal PDA session after the Xorg server.

export DISPLAY=:0.0
export HOME=/root

case "$1" in
    start)
        MATCHBOX_THEME=Default
        [ ! -r /etc/default/rx1950-ui ] || . /etc/default/rx1950-ui
        case "$MATCHBOX_THEME" in Default) ;; *) MATCHBOX_THEME=Default;; esac
        attempts=0
        while [ ! -S /tmp/.X11-unix/X0 ] && [ "$attempts" -lt 10 ]; do
            sleep 1
            attempts=$((attempts + 1))
        done
        [ -S /tmp/.X11-unix/X0 ] || exit 0
        # The Xlib shell is also the window manager. The keyboard remains
        # on-demand; no desktop, panel, applet or second WM stays resident.
        rx1950-shell >/var/log/rx1950-shell.log 2>&1 &
        if [ -r /etc/default/rx1950-power ]; then
            . /etc/default/rx1950-power
            case "${BLANK_SECONDS:-60}" in
                0) xset s off ;;
                *[!0-9]*) xset s 60 60 ;;
                *) xset s "$BLANK_SECONDS" "$BLANK_SECONDS" ;;
            esac
        fi
        ;;
    stop)
        killall matchbox-keyboard rx1950-shell 2>/dev/null || true
        ;;
esac
