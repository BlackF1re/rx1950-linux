#!/bin/sh
# Start the minimal PDA session after the Xorg server.

export DISPLAY=:0.0
export HOME=/root

case "$1" in
    start)
        MATCHBOX_THEME=Default
        [ ! -r /etc/default/rx1950-ui ] || . /etc/default/rx1950-ui
        case "$MATCHBOX_THEME" in Default) ;; *) MATCHBOX_THEME=Default;; esac
        attempts=0
        while [ ! -S /tmp/.X11-unix/X0 ] && [ "$attempts" -lt 10 ]; do
            sleep 1
            attempts=$((attempts + 1))
        done
        [ -S /tmp/.X11-unix/X0 ] || exit 0
        # One WM and one Xlib shell provide the whole resident session.
        # The keyboard remains on-demand.
        matchbox-window-manager -theme "$MATCHBOX_THEME" -use_titlebar yes \
            -use_dialog_mode const-horiz -use_desktop_mode plain \
            >/var/log/matchbox-window-manager.log 2>&1 &
        rx1950-shell >/var/log/rx1950-shell.log 2>&1 &
        if [ -r /etc/default/rx1950-power ]; then
            . /etc/default/rx1950-power
            case "${BLANK_SECONDS:-60}" in
                0) xset s off ;;
                *[!0-9]*) xset s 60 60 ;;
                *) xset s "$BLANK_SECONDS" "$BLANK_SECONDS" ;;
            esac
        fi
        ;;
    stop)
        killall matchbox-keyboard rx1950-shell matchbox-window-manager \
            2>/dev/null || true
        ;;
esac
