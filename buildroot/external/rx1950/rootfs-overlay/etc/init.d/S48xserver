#!/bin/sh
# Start Xorg directly on the S3C framebuffer with evdev touch and keys.

PIDFILE=/run/Xorg.pid
LOGFILE=/var/log/Xorg.log

case "${1:-start}" in
    start)
        [ -c /dev/fb0 ] || exit 0
        command -v Xorg >/dev/null 2>&1 || {
            echo 'Xorg is missing from the root filesystem' >&2
            exit 1
        }
        mkdir -p /tmp/.X11-unix /var/log
        rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
        Xorg :0 -config /etc/X11/xorg.conf -nolisten tcp -noreset \
            >"$LOGFILE" 2>&1 &
        echo $! > "$PIDFILE"
        ;;
    stop)
        if [ -s "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE")" 2>/dev/null || true
        fi
        rm -f "$PIDFILE"
        ;;
esac
