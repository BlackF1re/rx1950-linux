#!/bin/sh
# Safe WLAN bootstrap. Release images contain the verified ACX100 firmware.
# The power/wiring mode is a runtime setting and is not duplicated here.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH
POWER_MODE=historical
[ ! -r /etc/default/rx1950-wlan ] || . /etc/default/rx1950-wlan

case "${1:-start}" in
    start)
        if ! [ -r /lib/firmware/WLANGEN.BIN ] || ! [ -r /lib/firmware/RADIO0d.BIN ]; then
            rx1950-wlan-firmware import >/dev/kmsg 2>&1 || true
        fi
        if [ -r /lib/firmware/WLANGEN.BIN ] && [ -r /lib/firmware/RADIO0d.BIN ]; then
            rx1950-wlan start "${POWER_MODE:-historical}" >/dev/kmsg 2>&1
        fi
        ;;
    stop)
        rx1950-wlan stop >/dev/kmsg 2>&1
        ;;
esac
