#!/bin/sh
# Safe WLAN bootstrap. Release images contain the three verified ACX100
# firmware blobs required by the onboard TNETW1100B. A FAT import remains a
# recovery fallback if the rootfs copy was removed or replaced.
#
# The default start mode follows the historical RX1950 wiring, including the
# shared GPA11 WLAN-power/Blue line.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

case "${1:-start}" in
	start)
		if ! [ -r /lib/firmware/WLANGEN.BIN ] || ! [ -r /lib/firmware/RADIO0d.BIN ]; then
			rx1950-wlan-firmware import >/dev/kmsg 2>&1 || true
		fi
		if [ -r /lib/firmware/WLANGEN.BIN ] && [ -r /lib/firmware/RADIO0d.BIN ]; then
			rx1950-wlan start historical >/dev/kmsg 2>&1 || true
		fi
		;;
	stop)
		rx1950-wlan stop >/dev/kmsg 2>&1 || true
		;;
esac
