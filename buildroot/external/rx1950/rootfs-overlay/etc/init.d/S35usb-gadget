#!/bin/sh
# Provide a deterministic recovery channel over the supplied USB sync cable.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

case "$1" in
    start)
        attempts=0
        while ! ip link show usb0 >/dev/null 2>&1 && [ "$attempts" -lt 15 ]; do
            attempts=$((attempts + 1))
            sleep 1
        done

        if ip link show usb0 >/dev/null 2>&1; then
            ip link set usb0 up
            ip address replace 192.168.7.2/24 dev usb0
            /usr/sbin/rx1950-boot-probe usb-network-ready
        else
            /usr/sbin/rx1950-boot-probe usb0-unavailable
        fi
        ;;
esac
