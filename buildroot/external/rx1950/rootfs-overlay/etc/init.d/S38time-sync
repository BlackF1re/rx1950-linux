#!/bin/sh
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

case "${1:-start}" in
    start)
        if command -v rx1950-time-sync >/dev/null 2>&1; then
            rx1950-time-sync >/dev/null 2>&1 &
        fi
        ;;
    stop)
        killall rx1950-time-sync ntpd 2>/dev/null || true
        ;;
esac
